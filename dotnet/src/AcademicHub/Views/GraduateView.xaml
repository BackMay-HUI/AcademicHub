<UserControl x:Class="AcademicHub.Views.GraduateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4BB;" FontSize="28" Margin="0,0,15,0"/>
                    <TextBlock Text="保研模拟" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="模拟保研成绩计算" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="43,5,0,0"/>
            </StackPanel>

            <!-- Score Summary -->
            <Grid Grid.Row="1" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- GPA Score -->
                <Border Grid.Column="0" Background="{DynamicResource CardBrush}"
                        CornerRadius="14" Padding="25" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#x1F4DA;" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="学业成绩 (GPA x 25)" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding GpaScore, StringFormat='{}{0:F1}'}"
                                   FontSize="40" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Honor Bonus -->
                <Border Grid.Column="1" Background="{DynamicResource CardBrush}"
                        CornerRadius="14" Padding="25" Margin="6,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#x1F3C6;" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="荣誉加分" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HonorBonus, StringFormat='+{0:F1}'}"
                                   FontSize="40" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Total Score -->
                <Border Grid.Column="2" Background="{DynamicResource CardBrush}"
                        CornerRadius="14" Padding="25" Margin="12,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#x1F4CA;" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="综合得分" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalScore, StringFormat='{}{0:F1}'}"
                                   FontSize="40" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Honor Details -->
            <Border Grid.Row="2" Background="{DynamicResource CardBrush}"
                    CornerRadius="14" Padding="22" Margin="0,0,0,22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="&#x1F389;" FontSize="18" Margin="0,0,10,0"/>
                        <TextBlock Text="荣誉加分明细" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="国家级一等奖" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding NationalFirstCount}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource ChartColor1}"/>
                            <TextBlock Text="x 10分" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="6,0">
                            <TextBlock Text="国家级二等奖" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding NationalSecondCount}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource ChartColor1}"/>
                            <TextBlock Text="x 7分" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="6,0">
                            <TextBlock Text="省级一等奖" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ProvinceFirstCount}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource ChartColor2}"/>
                            <TextBlock Text="x 5分" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="12,0,0,0">
                            <TextBlock Text="校级" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SchoolLevelCount}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource ChartColor3}"/>
                            <TextBlock Text="x 1分" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Competition Honors -->
            <Border Grid.Row="3" Background="{DynamicResource CardBrush}"
                    CornerRadius="14" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="&#x1F3AF;" FontSize="18" Margin="0,0,10,0"/>
                        <TextBlock Text="竞赛与奖学金记录" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding CompetitionHonors}"
                              Style="{DynamicResource ModernDataGridStyle}"
                              ColumnHeaderStyle="{DynamicResource ModernDataGridColumnHeaderStyle}"
                              CellStyle="{DynamicResource ModernDataGridCellStyle}"
                              RowStyle="{DynamicResource ModernDataGridRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="荣誉名称" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="100"/>
                            <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="80"/>
                            <DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
