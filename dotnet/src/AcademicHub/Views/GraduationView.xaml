<UserControl x:Class="AcademicHub.Views.GraduationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F393;" FontSize="28" Margin="0,0,15,0"/>
                    <TextBlock Text="毕业追踪" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="追踪你的毕业学分进度" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="43,5,0,0"/>
            </StackPanel>

            <!-- Overall Progress -->
            <Border Grid.Row="1" Background="{DynamicResource CardBrush}"
                    CornerRadius="14" Padding="28" Margin="0,0,0,22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4CA;" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="总学分完成进度" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Grid Margin="0,22,0,0">
                            <ProgressBar Value="{Binding CompletionPercentage}"
                                         Maximum="100" Height="22"
                                         Style="{DynamicResource ModernProgressBarStyle}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="已获得: " FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalEarnedCredits, StringFormat='{}{0:F1}'}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text=" / 需要: " FontSize="14" Margin="18,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalRequiredCredits, StringFormat='{}{0:F1}'}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text=" 学分" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="45,0,0,0">
                        <TextBlock Text="{Binding CompletionPercentage, StringFormat='{}{0:F1}%'}"
                                   FontSize="46" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="完成度" FontSize="14"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Credit Requirements -->
            <Border Grid.Row="2" Background="{DynamicResource CardBrush}"
                    CornerRadius="14" Padding="22" Margin="0,0,0,22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="&#x1F4DD;" FontSize="18" Margin="0,0,10,0"/>
                        <TextBlock Text="各类学分要求" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Requirements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding RequirementType}"
                                               FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                                    <ProgressBar Grid.Column="1" Maximum="100" Height="18"
                                                 Margin="18,0"
                                                 Background="{DynamicResource BorderBrush}"
                                                 Foreground="{DynamicResource SuccessBrush}"
                                                 BorderThickness="0"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding RequiredCredits, StringFormat='{}{0:F0}学分'}"
                                               FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Add Requirement -->
            <Border Grid.Row="3" Background="{DynamicResource CardBrush}"
                    CornerRadius="14" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="&#x2795;" FontSize="18" Margin="0,0,10,0"/>
                        <TextBlock Text="设置毕业要求" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding RequirementTypes}"
                                  SelectedItem="{Binding NewRequirementType}"
                                  Width="130" Padding="10,8" Margin="0,0,12,0" FontSize="13">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBoxStyle}"/>
                            </ComboBox.Style>
                        </ComboBox>
                        <TextBox Text="{Binding NewRequiredCredits, UpdateSourceTrigger=PropertyChanged}"
                                 Width="110" Padding="10,8" Margin="0,0,12,0" FontSize="13">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="6">
                                                    <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="学分" VerticalAlignment="Center" Margin="0,0,18,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button Command="{Binding AddRequirementCommand}" Padding="18,10"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="White" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="{TemplateBinding Background}"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="+" FontSize="14" FontWeight="Bold" Margin="0,0,6,0"/>
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="添加要求"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
